# Institutional Vault API
IV_API_BASE_URL=https://your-vault-instance.example.com
IV_API_KEY=

# Vault user email (CWP InitiatorID / Canton Signing userIdentifier)
IV_INITIATOR_ID=

# Setup: register custom chain → create account → get address
# IV_CHAIN_NAME=custom/testnet
# IV_CAIP19=eip155:1337/slip44:60
# IV_CAIP2=eip155:1337
# IV_NATIVE_ASSET_SYMBOL=ETH
# IV_NATIVE_ASSET_DECIMALS=18
# IV_TEST_NET=true
# MASTER_KEY=Default
# IV_ACCOUNT_NAME=demo_account
# IV_ADDRESS_INDEX=0

# EVM examples (after get-address, set IV_SOURCE_ADDRESS from stdout)
IV_CAIP19=eip155:11155111/slip44:60
IV_EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/
# IV_SOURCE_ADDRESS=
# IV_TOKEN_CONTRACT_ADDRESS=
# IV_RECEIVER_ADDRESS=
# IV_TRANSFER_AMOUNT_WEI=35000000000000000000

# EVM RPC (for deploy example that broadcasts locally)
# EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Canton participant OAuth (client_credentials)
# CANTON_AUTH_ISSUER=https://your-keycloak.example.com/realms/your-realm
# CANTON_AUTH_CLIENT_ID=your-client-id
# CANTON_AUTH_CLIENT_SECRET=
# CANTON_AUTH_AUDIENCE=https://canton.network.global
# CANTON_AUTH_SCOPE=daml_ledger_api

# Participant JSON Ledger API
# LEDGER_CLIENT_URL=https://your-participant.example.com/api/json-api

# Canton party and key settings
# MASTER_KEY=Default
# CANTON_CAIP2=canton:devnet
# PARTY_HINT=ext-party-iv
# KEY_NAME=ext_party_iv

# Canton SDK (for raw-transfer example)
# VALIDATOR_URL=http://localhost:2000/api/validator
# SCAN_PROXY_URL=http://localhost:2000/api/validator
# CANTON_SOURCE_ADDRESS=
# CANTON_DESTINATION_ADDRESS=
# CANTON_TRANSFER_AMOUNT=1
