# Canton wallet SDK auth (client_credentials for devnet)
# OIDC issuer base URL (SDK appends /.well-known/openid-configuration for token discovery)
CANTON_AUTH_ISSUER=https://keycloak.dev.canton.blockdaemon.com/realms/canton-devnet
CANTON_AUTH_CLIENT_ID=bd-6-backend
CANTON_AUTH_CLIENT_SECRET=
CANTON_AUTH_AUDIENCE=https://bd-6.devnet.canton.network.global

# Canton wallet SDK endpoints
LEDGER_CLIENT_URL=https://bd-6-ledger.dev.canton.blockdaemon.com/api/json-api
VALIDATOR_URL=https://bd-6-wallet.dev.canton.blockdaemon.com/api/validator
SCAN_PROXY_URL=https://bd-6-wallet.dev.canton.blockdaemon.com/api/validator

# IV API
IV_API_BASE_URL=https://localhost
WALLET_API_KEY=
