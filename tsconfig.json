{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "*.ts",
    "iv-sdk-typescript/**/*.ts",
    "iv-sdk-canton-signing/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
  ]
}
